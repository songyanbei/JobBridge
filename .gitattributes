# The phase9 manifest hashes migration files byte-for-byte and the digests are
# recorded in the production `schema_migration_history` ledger.  With
# core.autocrlf=true a Windows checkout would materialize these files as CRLF,
# changing every digest and failing `apply_phase9_migrations.py --check`.
# Pin them to LF so the checksum is platform-independent.
backend/sql/migrations/** text eol=lf

# Phase11 manifest hashes Python migration helpers byte-for-byte too.
backend/scripts/phase11_resume_*.py text eol=lf

# WSL entrypoints must remain executable as LF files even on Windows checkouts.
mock-testbed/scripts/wsl-e2e-smoke.sh text eol=lf
mock-testbed/scripts/wsl-e2e-full-smoke.sh text eol=lf
mock-testbed/scripts/wsl-demo-start.sh text eol=lf
mock-testbed/scripts/wsl-stack-restart.sh text eol=lf
scripts/apply_sql_migration_compose.sh text eol=lf
