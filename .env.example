# ============================================================================
# JobBridge 环境变量配置模板
# 使用方法：复制为 .env 后填入真实值
# ============================================================================

# ---- 应用 ----
APP_ENV=development                   # development / production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-random-64-chars
LOG_FORMAT=text                         # production 默认 json；可显式覆盖 json / text
LOG_LEVEL=INFO

# 容器与进程时区。APScheduler / loguru / MySQL 都依赖此值。
# 不设置 → 镜像内使用 Dockerfile 默认（Asia/Shanghai）。
TZ=Asia/Shanghai

# ---- 数据库 MySQL 8.0+ ----
DB_HOST=localhost                       # 生产环境 docker 内用 mysql（compose service name）
DB_PORT=3306
DB_NAME=jobbridge
DB_USER=jobbridge
DB_PASSWORD=jobbridge                   # 生产环境必须改强密码
DB_ROOT_PASSWORD=root                   # 生产环境必须改强密码
DB_CONNECT_TIMEOUT_SECONDS=2            # 故障时快速失败，避免 webhook 卡住
DB_READ_TIMEOUT_SECONDS=5
DB_WRITE_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=3

# ---- Redis 7+ ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50               # 连接池上限，按并发量调整
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=2          # 必须大于 Worker BLPOP_TIMEOUT_SECONDS

# ---- 企业微信 ----
# 从企业微信管理后台获取
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=

# ---- LLM 供应商 ----
# 见方案 §4.3 LLM 抽象层
# provider 可选: qwen / doubao / local
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_API_BASE=
LLM_INTENT_MODEL=qwen-turbo
LLM_RERANKER_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=30
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_SECONDS=30
RERANKER_QUEUE_DEGRADE_THRESHOLD=10  # inbound 深度达到阈值时跳过非关键 LLM 重排

# ---- 对话理解 v2 / 搜索后体验策略（默认关闭，按灰度计划开启）----
DIALOGUE_V2_MODE=off                 # off / shadow / dual_read / primary
DIALOGUE_V2_PRIMARY_ROLLOUT_PERCENTAGE=0  # primary 模式用户灰度 0..100
POST_SEARCH_POLICY_MODE=off          # off / shadow / on
PHASE5_ROLLOUT_PERCENTAGE=0          # post-search Phase 5 用户灰度 0..100

# ---- 对象存储 ----
# 见方案 §4.2（一期选型待定）
OSS_PROVIDER=local                    # local / aliyun / tencent / minio
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_LOCAL_DIR=uploads                 # 本地存储目录（OSS_PROVIDER=local 时生效）
OSS_LOCAL_URL_PREFIX=/files           # 本地文件 URL 前缀

# ---- 运营后台鉴权 ----
ADMIN_JWT_SECRET=change-me-to-random-64-chars
ADMIN_JWT_EXPIRES_HOURS=24

# 强制首登改密：true 时管理员未改默认密码前，除 /admin/me 与 /admin/me/password
# 之外的接口一律返回 40301。生产部署前**必须**保持 true，避免 admin/admin123 被滥用。
ADMIN_FORCE_PASSWORD_CHANGE=true

# 默认/弱口令黑名单（逗号分隔）。命中场景：
#   1) 登录时 supplied password 命中 → 即便 password_changed=1 也强制重置为 0
#      （兜底"字段已置 1 但口令仍是 admin123"的历史脏数据）
#   2) 改密时 new_password 命中 → 直接拒绝
# 默认仅 seed.sql 的初始口令，运营可追加企业自有的弱口令清单。
ADMIN_DEFAULT_PASSWORDS=admin123

# ---- CORS ----
# 逗号分隔的允许域名列表，为空时开发环境允许全部，生产环境拒绝全部
# 生产示例：CORS_ORIGINS=https://admin.example.com,https://www.example.com
# 注意：APP_ENV=production 时不得为空或包含 "*"，启动会直接报错退出
CORS_ORIGINS=

# ---- 事件回传 API（Phase 5） ----
# 小程序点击事件回传使用的 API Key，与 JWT 分离；生产环境每季度轮换。
EVENT_API_KEY=

# ============================================================================
# Phase 5：推荐体验 / 匹配依据灰度（默认全部关闭）
# ============================================================================

# 总开关。false 时，即便下面所有 rollout 为 100，也不会展示匹配依据、
# 不构建 shadow reason、不启用软偏好排序、不展示软偏好 notice。
RECOMMENDATION_EXPERIENCE_ENABLED=false

# 匹配依据写入用户回复的灰度百分比，0..100。
RECOMMENDATION_REASON_ROLLOUT_PERCENTAGE=0

# shadow 构建结构化 reason 日志，不改变用户回复。
RECOMMENDATION_REASON_SHADOW_ENABLED=false

# 软偏好排序全局 kill switch 与独立用户灰度。
SOFT_PREFERENCE_RANKING_ENABLED=false
SOFT_PREFERENCE_RANKING_ROLLOUT_PERCENTAGE=0

# 单条软偏好匹配依据与总体 soft preference notice 灰度。
SOFT_PREFERENCE_REASON_ROLLOUT_PERCENTAGE=0
SOFT_PREFERENCE_NOTICE_ROLLOUT_PERCENTAGE=0

# 完整服务异步消息烟测：mock 企微出站写 Redis Pub/Sub。生产环境禁止开启。
MOCK_WEWORK_OUTBOUND=false
MOCK_WEWORK_REDIS_URL=redis://localhost:6379/0

# ============================================================================
# 推荐策略 v1：正文加密 / shadow 双算 / kill switch（方案 §7.5、§9.11、§11.5）
# ============================================================================

# ---- 推荐正文加密密钥环（§9.11）----
# **生产/预发必填**：推荐正文（含手机号等）以 AES-256-GCM 密文短期落库，
# 缺少密钥时投递会直接失败。密钥只来自 secrets/KMS，不要提交进仓库，
# 也不要写进日志 / 审计 / 数据库。建议 32 字节以上随机串。
RECOMMENDATION_CONTENT_KEY=

# 新写入密文使用的版本号（落到 content_key_version 列）。解密按行上记录的版本回查。
RECOMMENDATION_CONTENT_KEY_ACTIVE_VERSION=1

# 只读 key ring，格式 version:material，逗号分隔；单 key 部署可留空。
# 轮换顺序：先把新 key 加进 ring → 切 ACTIVE_VERSION → 等旧密文过期清理完
# → 再从 ring 移除旧 key。旧 key 必须保留到对应密文全部过期，否则历史密文解不开。
# 例：RECOMMENDATION_CONTENT_KEY_RING=1:old-secret,2:new-secret
RECOMMENDATION_CONTENT_KEY_RING=

# ---- shadow 双算（§7.5）----
# 属于运维配置，不在推荐策略后台开放给运营编辑。

# shadow 的绝对超时预算（秒）。在**提交 runner 之前**起算，包含排队、prompt 构造、
# 建连、写入、服务端响应和读取；runner 开始执行时只剩 remaining，不重新计时。
RECOMMENDATION_SHADOW_TIMEOUT_SECONDS=3.0

# 同一 provider 在**整个部署环境的全局并发上限**（不是每进程上限）。
# 真正的闸门是 Redis 全局 permit；Redis 不可用时 shadow fail-closed 跳过，
# 不得退化成"每进程各自并发 4"，否则 worker 横向扩容会线性放大供应商并发。
RECOMMENDATION_SHADOW_MAX_CONCURRENCY=4

# 每进程 shadow runner 待执行队列容量；满了记 shadow_skipped_capacity 并放弃，
# 不得挤占前台 legacy 的线程池或连接池。
RECOMMENDATION_SHADOW_QUEUE_CAPACITY=100

# shadow 结果持久化用的独立有界 executor（每进程）。event loop 回调只做 O(1)
# 投递，真正写库在这些线程里；队列满记 shadow_persistence_dropped，只影响观测。
RECOMMENDATION_SHADOW_PERSISTENCE_THREADS=2
RECOMMENDATION_SHADOW_PERSISTENCE_QUEUE_CAPACITY=100

# 方向级 shadow 日 token 预算（Asia/Shanghai 业务日，Redis Lua 原子预占）。
# 超预算直接跳过 shadow；超时调用按悲观上限计入预算，不退款。
# 下面是未经审批的保守占位值，扩量前必须替换为审批后的预算。0 = 该方向不跑 shadow。
RECOMMENDATION_SHADOW_DAILY_TOKEN_BUDGET_SEARCH_JOB=200000
RECOMMENDATION_SHADOW_DAILY_TOKEN_BUDGET_SEARCH_WORKER=200000
# 单次 shadow 预占预算使用的悲观输出上限；拿到真实 usage 后退回差额
RECOMMENDATION_SHADOW_MAX_OUTPUT_TOKENS=1024

# ---- 推荐策略 kill switch（§7.5）----
# 注意语义，别拿它当事故开关：
#   * 日常事故处置的真源是动态控制面 recommendation_runtime_control
#     （DB revision + Redis write-through + Pub/Sub，最大生效时间承诺 5 秒）；
#   * 这里设 true = 本进程启动时强制 off/legacy，压过 DB 里的任何取值；
#   * 这里设 false **永远不能覆盖 DB 里的 true**，它只是"不额外强制关闭"；
#   * 改本文件需要滚动重启全部 App/Worker 才生效，不是在线秒级开关。
RECOMMENDATION_STRATEGY_KILL_SWITCH=false

# ============================================================================
# Phase 7：定时任务 / 监控 / 日报
# ============================================================================

# APScheduler 使用的时区（cron 表达式按此解释）
SCHEDULER_TIMEZONE=Asia/Shanghai

# 接收日报 / 告警的企微群 chatid；为空时仅写 loguru，不推送群
DAILY_REPORT_CHAT_ID=

# 队列积压告警阈值（queue:incoming 超过则告警）
MONITOR_QUEUE_INCOMING_THRESHOLD=50
MONITOR_QUEUE_INCOMING_MAX_AGE_SECONDS=120

# 事务出站箱中最老未发送回复超过此秒数则告警
MONITOR_OUTBOX_PENDING_MAX_AGE_SECONDS=300
MONITOR_SESSION_COMMIT_PENDING_MAX_AGE_SECONDS=300

# 出站重试队列积压阈值（queue:send_retry / queue:group_send_retry）
MONITOR_SEND_RETRY_THRESHOLD=20

# 告警去重窗口（同一事件 N 秒内只推送一次企微群）
MONITOR_ALERT_DEDUPE_SECONDS=600

# Job lifecycle rollout and rollback gates
JOB_REPLACEMENT_ENABLED=true
JOB_EXPIRY_CLEANUP_ENABLED=true
JOB_CANDIDATE_CLEANUP_ENABLED=true
JOB_HARD_DELETE_ENABLED=true
